# ──────────────────────────────────────────────────────────────────────
# magnus-agent environment
# ──────────────────────────────────────────────────────────────────────
# Copy to $AGENT_INSTALL_DIR/.env (default /opt/magnus-agent/.env), or pass
# `--env-file <path>`, and keep it mode 0600. Variables already present in the
# environment take precedence. `magnus-agent env-schema` prints every key and
# `magnus-agent check` validates the result without starting.

# ══ Required ══════════════════════════════════════════════════════════

# magnus-server Control API this node enrolls with.
CONTROL_API_URL=https://magnus.example.com:4000
# Node credential shared with the Control API (32+ characters). Generate with
# `openssl rand -hex 32` and register the same value for this node on the server.
NODE_MANAGER_SECRET=
# Independent command-result signing key (32+ characters). Never reuse
# NODE_MANAGER_SECRET.
RESULT_SIGNING_SECRET=

# Listener TLS (absolute, or relative to AGENT_INSTALL_DIR). Required when
# NODE_ENV=production; configured but missing files fail closed.
TLS_CERT_PATH=/opt/magnus-agent/certs/agent.crt
TLS_KEY_PATH=/opt/magnus-agent/certs/agent.key

NODE_ENV=production

# Privileged mode (default true) runs as root with every executor; startup
# fails if the process is not root. Set false to run as an ordinary account:
# cron, users, system updates, docker-group remediation, Ardent management,
# credential renewal and the execution supervisor are then disabled and their
# routes return 403 AGENT_NOT_PRIVILEGED.
MAGNUS_AGENT_PRIVILEGED=true

# ══ Optional ══════════════════════════════════════════════════════════

# ── Identity and listener ────────────────────────────────────────────
# Host identity reported to the Control API (default: `hostname --fqdn`).
# HOST_FQDN=node-1.example.com
# NODE_MANAGER_PORT=4100
# TLS listens on all interfaces by default; development HTTP on loopback.
# NODE_MANAGER_BIND_HOST=0.0.0.0
# Development only: plain HTTP on loopback. Rejected in production.
# ALLOW_INSECURE_HTTP=false
# PEM CA bundle for a private-CA Control API. The URL hostname must be in the
# certificate SAN; verification is never disabled.
# CONTROL_API_CA_PATH=/etc/magnus-agent/control-api-ca.pem
# Renew a Tailscale-issued listener certificate with `tailscale cert`.
# MAGNUS_AGENT_TLS_RENEWAL=tailscale

# ── Command execution ────────────────────────────────────────────────
# ENABLE_NODE_MANAGEMENT=true
# Durable execution supervisor for commands (off until your server enables it).
# MAGNUS_EXECUTION_SUPERVISOR_ENABLED=false
# Independent key for explicit command-receipt reconciliation. Leave unset unless
# your control plane uses it. Linux /usr/bin/flock is required for commands.
# COMMAND_RECONCILIATION_SECRET=
# Rotation windows: previous values accepted alongside the current ones.
# NODE_MANAGER_SECRET_PREVIOUS=
# RESULT_SIGNING_PREVIOUS_SECRET=

# ── Authenticated UDP discovery (default off) ────────────────────────
# ENABLE_AGENT_DISCOVERY=false
# AGENT_DISCOVERY_SECRET=
# Explicit IPv4 interface address; wildcard binds are rejected.
# AGENT_DISCOVERY_BIND_ADDRESS=192.0.2.10

# ── Logs and traces ──────────────────────────────────────────────────
# ENABLE_LOG_FORWARDING=false
# LOG_INGEST_TOKEN=
# LOG_UNITS=magnus-agent.service
# OTEL_ENABLED=true
# OTEL_EXPORTER_OTLP_ENDPOINT=https://otel.example.com:4318
LOG_LEVEL=info

# ── Skills ───────────────────────────────────────────────────────────
# SKILLS_DIR=/opt/magnus-agent/skills
# SKILLS_EXTRA_DIRS=

# ── Hermes Agent (optional) ──────────────────────────────────────────
# Local account that owns Hermes Agent (~/.hermes). Leave unset when Hermes is
# not installed.
# HERMES_USER=operator
# 64-hex token issued by the Control API for this node's magnus-hermes-sync job.
# HERMES_REGISTRY_TOKEN=
# Let magnus-hermes-sync apply desired state from the registry.
# MAGNUS_HERMES_SYNC_PULL=false

# ── Codex CLI (optional) ─────────────────────────────────────────────
# Account whose Codex CLI and ChatGPT login are managed (default: HERMES_USER,
# then the invoking user). Credentials stay in that user's Codex home.
# CODEX_USER=operator
# CODEX_BIN=/usr/local/bin/codex
# CODEX_HOME=/home/operator/.codex

# ── Ardent (optional) ────────────────────────────────────────────────
# ARDENT_OWNER_USER=operator
# ARDENT_STAGED_PACKAGE=/opt/magnus-agent/ardent-package.tgz
# Scoped npm names accepted as the Ardent runtime, in preference order. Add an
# older build's package name to keep managing it (interoperating with older components).
# MAGNUS_AGENT_ARDENT_PACKAGES=@hivemagnus/ardent

# ── HiveMem credential renewal (optional, all lists empty by default) ─
# Entries live in a root-owned 0600 JSON file; the lists below bound what the
# entries may touch.
# MAGNUS_AGENT_RENEWAL_CONFIG=/opt/magnus-agent/credential-renewal.json
# MAGNUS_AGENT_RENEWAL_ENDPOINTS=https://hivemem.example.com
# MAGNUS_AGENT_RENEWAL_UNITS=hermes-gateway.service
# MAGNUS_AGENT_RENEWAL_USERS=operator
# MAGNUS_AGENT_RENEWAL_ARDENT_PROFILES=
# MAGNUS_AGENT_RENEWAL_TOKEN_FILES=
# MAGNUS_AGENT_RENEWAL_SIGNING_ENV_FILES=

# ── Runtime ──────────────────────────────────────────────────────────
# Installation directory (set by the systemd unit).
# AGENT_INSTALL_DIR=/opt/magnus-agent
# MAGNUS_AGENT_WORKSPACE_ROOT=/var/lib/magnus-agent/workspaces
# Account the docker-group heartbeat check verifies (default: the agent's own user).
# MAGNUS_AGENT_DOCKER_USER=operator

# ── Self-upgrade (after `sudo magnus-agent install-service`) ─────────
# Accept server-driven upgrades to an exact version and integrity.
# MAGNUS_AGENT_SELF_UPGRADE=true
# Seconds a new version has to report a heartbeat before the launcher reverts it.
# MAGNUS_AGENT_UPGRADE_CONFIRM_SECONDS=180
# Refuse upgrades whose packages fail `npm audit signatures`.
# MAGNUS_AGENT_UPGRADE_REQUIRE_PROVENANCE=true
# Offline nodes: install from hivemagnus-magnus-agent-<X>.tgz files in this directory.
# MAGNUS_AGENT_UPGRADE_SOURCE_DIR=
# MAGNUS_AGENT_NPM=npm
