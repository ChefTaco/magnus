{
  "name": "@hivemagnus/magnus-agent",
  "version": "2.1.3",
  "description": "Magnus node agent: a small daemon that enrolls a Linux host with a magnus-server and runs authenticated health, command, cron, file and skill management, with optional Hermes Agent, Codex and Ardent management.",
  "keywords": [
    "magnus",
    "fleet",
    "agent",
    "node",
    "ops",
    "systemd",
    "cron",
    "hermes-agent",
    "codex"
  ],
  "license": "Apache-2.0",
  "author": "ChefTaco",
  "homepage": "https://github.com/ChefTaco/magnus/tree/main/packages/agent#readme",
  "bugs": {
    "url": "https://github.com/ChefTaco/magnus/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ChefTaco/magnus.git",
    "directory": "packages/agent"
  },
  "type": "module",
  "bin": {
    "magnus-agent": "dist/index.js"
  },
  "files": [
    "npm-shrinkwrap.json",
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "dist/ardent-context-bundle.json",
    "!dist/**/*.test.*",
    "README.md",
    "LICENSE",
    "NOTICE",
    ".env.example",
    "deploy/*.service",
    "deploy/*.timer",
    "launcher/launcher.mjs",
    "scripts/magnus-security-containment"
  ],
  "engines": {
    "node": "^24.22.1 || ^26.13.0"
  },
  "magnusAgent": {
    "minLauncher": 1
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "npm run clean && tsc --build && node build-context-bundle.mjs && node ../../scripts/refresh-agent-lock.mjs",
    "dev": "tsx watch src/index.ts start",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:ci": "vitest run --passWithNoTests --coverage",
    "clean": "node -e \"const fs=require('node:fs');fs.rmSync('dist',{recursive:true,force:true});fs.rmSync('tsconfig.tsbuildinfo',{force:true})\""
  },
  "dependencies": {
    "@hivemagnus/magnus-contracts": "2.1.3",
    "@hono/node-server": "^2.1.6",
    "dotenv": "^18.0.9",
    "hono": "^4.13.16",
    "ky": "^2.2.0",
    "nanoid": "^6.0.2",
    "tar-stream": "3.2.2",
    "undici": "^8.12.3",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@hivemagnus/ardent": "2.1.1",
    "@types/node": "^24.19.2",
    "@types/tar-stream": "^3.1.5",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  }
}
