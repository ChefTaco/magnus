# Example systemd unit for magnus-agent.
#
# Install the package below a stable directory so its private .env and
# .magnus state survive upgrades:
#   sudo npm install --prefix /opt/magnus-agent @hivemagnus/magnus-agent
#   sudo install -m 0600 /opt/magnus-agent/node_modules/@hivemagnus/magnus-agent/.env.example /opt/magnus-agent/.env
#
# The agent runs as root because it manages system cron, systemd units, files
# and local accounts on the host. Limit what it may do through server-side
# policy and the agent's own allowlists. This is privileged mode
# (MAGNUS_AGENT_PRIVILEGED=true, the default); to run without root, use
# magnus-agent-unprivileged.service instead.
#
# These example units start the agent directly and cannot self-upgrade. For
# server-driven upgrades, run `sudo magnus-agent install-service` instead: it
# moves the install into versions/<X>, installs the upgrade launcher and writes
# a unit that starts it (the cron path below node_modules keeps working).
[Unit]
Description=Magnus Agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/magnus-agent
Environment=AGENT_INSTALL_DIR=/opt/magnus-agent
EnvironmentFile=/opt/magnus-agent/.env
ExecStart=/usr/bin/node /opt/magnus-agent/node_modules/@hivemagnus/magnus-agent/dist/index.js start
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
NoNewPrivileges=true
# Commands the agent starts itself share this private /tmp and /var/tmp (not
# the host's), emptied whenever the agent stops or restarts.
PrivateTmp=true
UMask=0077
LockPersonality=true
RestrictRealtime=true
SystemCallArchitectures=native
TasksMax=4096
# Not set in privileged mode on purpose. A root agent can start anything
# through systemd, so they are no boundary here; they would only break its work:
# - ProtectKernelModules hides /usr/lib/modules and blocks module loading
#   (kernel upgrades, DKMS, update-initramfs and modprobe fail).
# - ProtectClock implies DeviceAllow=char-rtc r, which blocks every physical
#   device (nvidia-smi needs /dev/nvidia*) and all clock system calls.
# - MemoryMax caps every command too; at the limit the kernel kills inside the
#   unit and the default OOMPolicy=stop stops it, killing running commands.
# Add any of them in a drop-in if a host does not need that (MemoryHigh=
# throttles instead of killing).

[Install]
WantedBy=multi-user.target
