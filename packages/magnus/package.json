{
  "name": "@hivemagnus/magnus",
  "version": "3.3.4",
  "description": "Install, upgrade and roll back a Magnus server and console with one command: `npx @hivemagnus/magnus init`, then `magnus upgrade`. Pins exact, tested component versions, backs up PostgreSQL before every migration and reverts automatically when the new version fails its health check.",
  "keywords": [
    "magnus",
    "fleet",
    "installer",
    "upgrade",
    "self-hosted",
    "systemd"
  ],
  "license": "Apache-2.0",
  "author": "ChefTaco",
  "homepage": "https://github.com/ChefTaco/magnus/tree/main/packages/magnus#readme",
  "bugs": {
    "url": "https://github.com/ChefTaco/magnus/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ChefTaco/magnus.git",
    "directory": "packages/magnus"
  },
  "type": "module",
  "bin": {
    "magnus": "dist/cli.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "!dist/**/*.test.*",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": "^24.22.3 || ^26.13.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "npm run clean && tsc --build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "clean": "node -e \"const fs=require('node:fs');fs.rmSync('dist',{recursive:true,force:true});fs.rmSync('tsconfig.tsbuildinfo',{force:true})\""
  },
  "dependencies": {
    "@hivemagnus/magnus-contracts": "3.3.4"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  },
  "magnusRelease": {
    "schema": 1,
    "version": "3.3.4",
    "engines": {
      "node": "^24.22.3 || ^26.13.1"
    },
    "components": {
      "@hivemagnus/magnus-server": "3.3.4",
      "@hivemagnus/magnus-ui": "3.3.4",
      "@hivemagnus/magnus-contracts": "3.3.4",
      "@hivemagnus/magnus-agent": "3.3.4"
    },
    "breaking": false,
    "minUpgradeFrom": "2.10.2",
    "engineProtocol": 2,
    "newRequiredEnv": [],
    "newOptionalEnv": [],
    "removedEnv": [],
    "migrations": [
      {
        "name": "20261124190000_ardent_agent_operation_definition_kind",
        "impact": "fast",
        "note": "Widen the Ardent operation kind check to the definition installs Magnus 3.3.0 records; existing rows already satisfy it and are unchanged."
      }
    ],
    "agent": {
      "selfUpgradeProtocol": 1,
      "minLauncher": 1
    },
    "summary": "Portable agent-definition installs work: the Ardent operations check constraint now allows the definition kind that Magnus 3.3.0 records, so POST /api/v1/ardent/agent-definitions/install no longer fails with 500 after its preflight. One fast additive migration widens the constraint; existing rows already satisfy it. No settings change.",
    "notesUrl": "https://github.com/ChefTaco/magnus/releases/tag/v3.3.4",
    "allowScripts": {
      "@prisma/engines": true,
      "argon2": true,
      "better-sqlite3": true,
      "cpu-features": true,
      "msgpackr-extract": true,
      "prisma": true,
      "sharp": true,
      "ssh2": true
    }
  }
}
