{
  "name": "@hivemagnus/magnus",
  "version": "2.10.3",
  "description": "Install, upgrade and roll back a Magnus server and console with one command: `npx @hivemagnus/magnus init`, then `magnus upgrade`. Pins exact, tested component versions, backs up PostgreSQL before every migration and reverts automatically when the new version fails its health check.",
  "keywords": [
    "magnus",
    "fleet",
    "installer",
    "upgrade",
    "self-hosted",
    "systemd"
  ],
  "license": "Apache-2.0",
  "author": "ChefTaco",
  "homepage": "https://github.com/ChefTaco/magnus/tree/main/packages/magnus#readme",
  "bugs": {
    "url": "https://github.com/ChefTaco/magnus/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ChefTaco/magnus.git",
    "directory": "packages/magnus"
  },
  "type": "module",
  "bin": {
    "magnus": "dist/cli.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "!dist/**/*.test.*",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": "^24.22.3 || ^26.13.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "npm run clean && tsc --build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "clean": "node -e \"const fs=require('node:fs');fs.rmSync('dist',{recursive:true,force:true});fs.rmSync('tsconfig.tsbuildinfo',{force:true})\""
  },
  "dependencies": {
    "@hivemagnus/magnus-contracts": "2.10.3"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  },
  "magnusRelease": {
    "schema": 1,
    "version": "2.10.3",
    "engines": {
      "node": "^24.22.3 || ^26.13.1"
    },
    "components": {
      "@hivemagnus/magnus-server": "2.10.3",
      "@hivemagnus/magnus-ui": "2.10.3",
      "@hivemagnus/magnus-contracts": "2.10.3",
      "@hivemagnus/magnus-agent": "2.10.3"
    },
    "breaking": false,
    "minUpgradeFrom": "1.0.0",
    "engineProtocol": 2,
    "newRequiredEnv": [],
    "newOptionalEnv": [],
    "removedEnv": [],
    "migrations": [],
    "agent": {
      "selfUpgradeProtocol": 1,
      "minLauncher": 1
    },
    "summary": "Stepping stone to 3.0.x agents: the 2.10.3 agent accepts a self-upgrade across a major version only when the request carries an authorization signed by the server key it pins, for this node, the version it runs, the target version and its tarball integrity, with an expiry (3.0.1 servers send it with agents upgrade --allow-major). Without one it refuses the major as before. Nothing else changes. 2.10.x agents reach 2.10.3 with the usual managed upgrade. On npm 2.10.3 is tagged maintenance-2.10; latest stays on 3.0.x. No migrations and no new settings.",
    "notesUrl": "https://github.com/ChefTaco/magnus/releases/tag/v2.10.3",
    "allowScripts": {
      "@prisma/engines": true,
      "argon2": true,
      "better-sqlite3": true,
      "cpu-features": true,
      "msgpackr-extract": true,
      "prisma": true,
      "sharp": true,
      "ssh2": true
    }
  }
}
