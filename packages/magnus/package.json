{
  "name": "@hivemagnus/magnus",
  "version": "2.3.0",
  "description": "Install, upgrade and roll back a Magnus server and console with one command: `npx @hivemagnus/magnus init`, then `magnus upgrade`. Pins exact, tested component versions, backs up PostgreSQL before every migration and reverts automatically when the new version fails its health check.",
  "keywords": [
    "magnus",
    "fleet",
    "installer",
    "upgrade",
    "self-hosted",
    "systemd"
  ],
  "license": "Apache-2.0",
  "author": "ChefTaco",
  "homepage": "https://github.com/ChefTaco/magnus/tree/main/packages/magnus#readme",
  "bugs": {
    "url": "https://github.com/ChefTaco/magnus/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ChefTaco/magnus.git",
    "directory": "packages/magnus"
  },
  "type": "module",
  "bin": {
    "magnus": "dist/cli.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "!dist/**/*.test.*",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": "^24.22.1 || ^26.13.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "npm run clean && tsc --build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "clean": "node -e \"const fs=require('node:fs');fs.rmSync('dist',{recursive:true,force:true});fs.rmSync('tsconfig.tsbuildinfo',{force:true})\""
  },
  "dependencies": {
    "@hivemagnus/magnus-contracts": "2.3.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  },
  "magnusRelease": {
    "schema": 1,
    "version": "2.3.0",
    "engines": {
      "node": "^24.22.1 || ^26.13.0"
    },
    "components": {
      "@hivemagnus/magnus-server": "2.3.0",
      "@hivemagnus/magnus-ui": "2.3.0",
      "@hivemagnus/magnus-contracts": "2.3.0",
      "@hivemagnus/magnus-agent": "2.3.0"
    },
    "breaking": false,
    "minUpgradeFrom": "1.0.0",
    "engineProtocol": 2,
    "newRequiredEnv": [],
    "newOptionalEnv": [
      {
        "name": "MAGNUS_AGENT_MANAGED_TERMINAL_USER",
        "component": "agent",
        "secret": false,
        "description": "Dedicated non-root account without supplementary groups for restricted managed terminals. Requires privileged mode, the execution supervisor and full node enrollment; unset keeps this feature disabled."
      }
    ],
    "removedEnv": [],
    "migrations": [
      {
        "name": "20261109140000_managed_terminal_claim",
        "impact": "fast",
        "note": ""
      },
      {
        "name": "20261109143000_managed_terminal_claim_guard",
        "impact": "fast",
        "note": ""
      }
    ],
    "agent": {
      "selfUpgradeProtocol": 1,
      "minLauncher": 1
    },
    "summary": "Managed web terminals for fully enrolled nodes, with a restricted systemd PTY, single-use admission and signed process-group cleanup. Full enrollment continues to support node commands and managed cron without accepting raw SSH disconnects as completion evidence.",
    "notesUrl": "https://github.com/ChefTaco/magnus/releases/tag/v2.3.0",
    "allowScripts": {
      "@prisma/engines": true,
      "argon2": true,
      "better-sqlite3": true,
      "cpu-features": true,
      "msgpackr-extract": true,
      "prisma": true,
      "sharp": true,
      "ssh2": true
    }
  }
}
