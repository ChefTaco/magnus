{
  "name": "@hivemagnus/ardent",
  "version": "1.0.0",
  "description": "Headless TypeScript agent runtime with A2A, scheduled jobs, skills, chat channels, and a plugin API",
  "keywords": [
    "agent",
    "ai-agent",
    "a2a",
    "agent-runtime",
    "llm",
    "llama.cpp",
    "codex",
    "telegram",
    "mattermost",
    "scheduler"
  ],
  "author": "ChefTaco",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ChefTaco/magnus.git",
    "directory": "packages/ardent"
  },
  "homepage": "https://github.com/ChefTaco/magnus/tree/main/packages/ardent#readme",
  "bugs": {
    "url": "https://github.com/ChefTaco/magnus/issues"
  },
  "type": "module",
  "bin": {
    "ardent": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "engines": {
    "node": "^24.22.1 || ^26.13.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "profiles/assistant",
    "protocol",
    "model-policy.default.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc --build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --exclude 'test/interop/**'",
    "interop:test": "vitest run test/interop",
    "lint": "eslint src test",
    "protocol:check": "node scripts/verify-protocol.mjs",
    "openapi:check": "npm run build && node scripts/check-openapi.mjs",
    "openapi:write": "npm run build && node scripts/check-openapi.mjs --write",
    "pack:check": "node scripts/check-package.mjs"
  },
  "dependencies": {
    "@a2a-js/sdk": "1.2.1",
    "@bufbuild/protobuf": "2.10.2",
    "@grpc/grpc-js": "1.14.5",
    "@hono/node-server": "^2.1.5",
    "better-sqlite3": "^12.11.1",
    "dotenv": "^17.3.1",
    "express": "5.1.0",
    "hono": "^4.13.8",
    "ws": "^8.21.0",
    "yaml": "2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "^13.1.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "5.0.3",
    "@types/node": "^22.10.0",
    "@types/ws": "^8.18.1",
    "openapi-typescript": "^7.13.0",
    "typescript": "^5.8.3",
    "vitest": "^4.1.12"
  }
}
