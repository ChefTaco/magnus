{
  "name": "magnus",
  "version": "2.1.2",
  "private": true,
  "description": "Magnus: self-hosted fleet management for Linux hosts and AI agents (UI, server, node agent)",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "npm@11.16.0",
  "engines": {
    "node": "^24.22.1 || ^26.13.0"
  },
  "workspaces": [
    "apps/*",
    "services/*",
    "packages/*"
  ],
  "overrides": {
    "@hono/node-server": "2.1.6",
    "@prisma/config": {
      "deepmerge-ts": "8.0.1"
    },
    "fast-uri": "3.1.9",
    "postcss": {
      ".": "8.5.32",
      "nanoid": "3.3.18"
    },
    "npm": {
      "brace-expansion": "5.0.12",
      "ip-address": "10.4.0",
      "tar": "7.5.22",
      "undici": "7.30.1"
    },
    "sharp": "0.35.5",
    "mysql2": "3.24.4",
    "tinypool": "2.2.0",
    "minimatch": "11.0.3",
    "@redocly/openapi-core": "1.34.22",
    "openapi-typescript": {
      "typescript": "$typescript"
    }
  },
  "scripts": {
    "build": "npm run build -w @hivemagnus/magnus-contracts -w @hivemagnus/magnus-oathweave -w @hivemagnus/magnus-skills -w @hivemagnus/magnus-agent -w @hivemagnus/magnus-server -w @hivemagnus/magnus-fleet-gateway -w @hivemagnus/magnus-ui -w @hivemagnus/magnus",
    "test": "npm run test --workspaces --if-present && npm run test:native-artifact",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "verify:ui": "npm --workspace @hivemagnus/magnus-ui run test:e2e -- --project=chromium tests/navigation.spec.ts",
    "verify:ui:ci": "npm --workspace @hivemagnus/magnus-ui run test:e2e -- --config playwright.ci.config.ts",
    "openapi:check": "node scripts/check-openapi-contract.mjs",
    "lockfile:check": "node scripts/validate-lockfile.mjs",
    "docs:check": "node scripts/check-repository-docs.mjs && node scripts/check-documentation.mjs",
    "docs:links": "node scripts/check-repository-docs.mjs",
    "docs:test": "node --test scripts/test-repository-docs.mjs",
    "docs:generate": "node scripts/generate-documentation.mjs",
    "clean:local": "node scripts/clean-local.mjs",
    "clean:local:test": "node --test scripts/test-clean-local.mjs",
    "tls:check": "node scripts/check-tls-endpoint.mjs",
    "dashboard:build": "npm --workspace @hivemagnus/magnus-ui run build",
    "dashboard:test": "npm --workspace @hivemagnus/magnus-ui test",
    "contracts:build": "npm --workspace @hivemagnus/magnus-contracts run build",
    "contracts:browser": "node scripts/export-browser-contracts.mjs",
    "control-api:build": "npm --workspace @hivemagnus/magnus-server run build",
    "control-api:test": "npm --workspace @hivemagnus/magnus-server test",
    "agent:build": "npm --workspace @hivemagnus/magnus-agent run build",
    "agent:test": "npm --workspace @hivemagnus/magnus-agent test",
    "skills:build": "npm --workspace @hivemagnus/magnus-skills run build",
    "skills:check": "npm --workspace @hivemagnus/magnus-skills run catalog:check",
    "ardent:openapi:check": "node scripts/check-ardent-openapi.mjs",
    "ardent:openapi:write": "node scripts/check-ardent-openapi.mjs --write",
    "ardent:context:integration": "node scripts/test-ardent-context-adoption.mjs",
    "audit:production": "npm audit --omit=dev --audit-level=high",
    "scan:secrets": "bash scripts/scan-secrets.sh",
    "check:private": "bash scripts/check-private-data.sh",
    "check:packs": "node scripts/check-npm-packs.mjs",
    "check:reasons": "node scripts/check-swallowed-reasons.mjs",
    "check:remedies": "node scripts/check-upgrade-remedies.mjs",
    "privacy:test": "node --test scripts/test-privacy-policy.mjs scripts/test-publish-environment.mjs scripts/test-publish-packages.mjs",
    "reasons:test": "node --test scripts/test-swallowed-reasons.mjs",
    "release:manifest": "node scripts/check-release-manifest.mjs --write",
    "release:manifest:check": "node scripts/check-release-manifest.mjs",
    "release:bump": "node scripts/bump-version.mjs",
    "release:test": "node --test scripts/test-release-tooling.mjs",
    "hooks:install": "git config core.hooksPath .githooks",
    "verify": "npm run privacy:test && npm run reasons:test && npm run check:reasons && npm run check:remedies && npm run scan:secrets && npm run check:private && npm run build && npm run typecheck && npm run test && npm run skills:check && npm run openapi:check && npm run ardent:openapi:check && npm run check:packs && npm run release:manifest:check && npm run release:test && npm run docs:check && npm run docs:test && npm run clean:local:test",
    "build:native-agent": "node scripts/build-native-agent.mjs",
    "test:native-artifact": "node --test scripts/build-native-agent.test.mjs scripts/native-hermes.test.mjs scripts/native-codex.test.mjs scripts/entrypoint-health.test.mjs scripts/test-agent-lock.mjs",
    "test:native-codex": "node scripts/check-native-codex.mjs",
    "test:rehearsal-runtime": "node scripts/check-rehearsal-runtime.mjs",
    "build:native-hermes": "node scripts/build-native-hermes-image.mjs",
    "test:native-hermes": "node scripts/check-native-hermes.mjs"
  },
  "allowScripts": {
    "@prisma/engines@7.10.1": true,
    "argon2@0.45.1": true,
    "better-sqlite3@13.0.3": true,
    "cpu-features@0.0.10": true,
    "esbuild@0.28.2": true,
    "msgpackr-extract@3.0.4": true,
    "prisma@7.10.1": true,
    "protobufjs@7.6.6": true,
    "ssh2@1.17.0": true
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "13.1.0",
    "@hivemagnus/ardent": "2.1.1",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "openapi-typescript": "7.13.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "yaml": "2.9.1"
  }
}
