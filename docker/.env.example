# Settings for docker/compose.yml. Copy to docker/.env (keep it private) and
# fill in every value marked required. Generate each secret with
# `openssl rand -hex 32`; all of them must be different.

# Image tag: 1 follows every 1.x release (never 2.x); 1.1 only patches; 1.1.0 pins one release.
MAGNUS_VERSION=1

# Required
POSTGRES_PASSWORD=
REDIS_PASSWORD=
API_SECRET=
JWT_SECRET=
NODE_MANAGER_SECRET=
AUDIT_HMAC_SECRET=
RESULT_SIGNING_SECRET=
LOG_INGEST_SIGNING_SECRET=
CREDENTIAL_ROTATION_KEY=
METRICS_TOKEN=
WEBHOOK_ENCRYPTION_KEY=
SESSION_SECRET=
CONTROL_NODE_CREDENTIAL_KEY=
# Argon2id hash of the console password; see apps/dashboard/README.md.
DASHBOARD_ADMIN_PASSWORD_HASH=

# Optional
# DASHBOARD_ADMIN_USERNAME=admin
# DASHBOARD_PUBLIC_ORIGIN=https://localhost:3000
# CONTROL_API_URL=https://localhost:4000
# MAGNUS_PORT=4000
# MAGNUS_UI_PORT=3000
# Upgrades (see UPGRADING.md)
# MAGNUS_AUTO_MIGRATE=true
# MAGNUS_AUTO_MIGRATE_ALLOW_SLOW=false
# MAGNUS_UPDATE_CHECK=true
# MAGNUS_AGENT_UPGRADES=true
# Opt in to label-scoped Watchtower updates of the Magnus containers.
# MAGNUS_WATCHTOWER=false
