# Magnus UI environment example.
# Copy to a private file (for example /etc/magnus-ui/magnus-ui.env, mode 0600),
# fill in the values, then run `magnus-ui check --env-file <file>`.
# `magnus-ui env-schema` prints every supported variable.

# ── Required ─────────────────────────────────────────────────────────────────

# Magnus Control API (magnus-server) reached server-side by the UI.
CONTROL_API_URL=https://magnus-api.example.com:4000
# Must match API_SECRET on the Control API. Never expose it via NEXT_PUBLIC_*.
API_SECRET=change-me-api-secret
# Dashboard-only session signing secret (32+ random characters). Do not reuse API_SECRET.
SESSION_SECRET=change-me-dashboard-only-random-secret
# Dedicated 32+ character key for encrypted control-node credentials at rest.
CONTROL_NODE_CREDENTIAL_KEY=change-me-control-node-storage-key
# Redis for durable login throttling (login fails closed without it).
REDIS_URL=redis://127.0.0.1:6379
# Canonical browser origin of this UI.
DASHBOARD_PUBLIC_ORIGIN=https://magnus.example.com

# Administrator login. Generate the Argon2id verifier with:
#   node --input-type=module -e "import argon2 from 'argon2'; console.log(await argon2.hash(process.env.PASSWORD,{type:argon2.argon2id}))"
DASHBOARD_ADMIN_USERNAME=admin
DASHBOARD_ADMIN_PASSWORD_HASH='$argon2id$v=19$m=65536,t=3,p=1$replace-me'

# ── Server ───────────────────────────────────────────────────────────────────

# Listen address and port for `magnus-ui start`.
# HOST=0.0.0.0
# PORT=3000
# TLS certificate and key. Required unless MAGNUS_UI_ALLOW_HTTP=true.
TLS_CERT_PATH=/etc/magnus-ui/tls/server.crt
TLS_KEY_PATH=/etc/magnus-ui/tls/server.key
# Serve plain HTTP (local development, or behind a TLS-terminating proxy only).
# MAGNUS_UI_ALLOW_HTTP=false
# Directory for runtime state (.magnus/, terminal-audit/). Defaults to the
# directory `magnus-ui start` runs in.
# MAGNUS_UI_DATA_DIR=/var/lib/magnus-ui
# Authentication audit log (login fails closed if it cannot be written).
# UI_SECURITY_LOG_PATH=/var/lib/magnus-ui/.magnus/security-events.jsonl
# Optional private CA bundle for the Control API certificate.
# CONTROL_API_CA_PATH=/etc/magnus-ui/control-api-ca.pem

# ── Optional integrations (off unless configured) ────────────────────────────

# External security console: shows the Security nav entry and links to it.
# MAGNUS_SECURITY_CONSOLE_URL=https://security.example.com

# Hive Router admin plane, embedded through /api/hive-router/dashboard.
# HIVE_ROUTER_ADMIN_URL=https://router.example.com
# HIVE_ROUTER_CA_PATH=/etc/magnus-ui/hive-router-ca.pem

# Hive IAM named login (OIDC). All of these plus DASHBOARD_PUBLIC_ORIGIN are required.
# HIVE_OAUTH_DISCOVERY_URL=https://iam.example.com/.well-known/openid-configuration
# HIVE_OAUTH_CLIENT_ID=magnus-ui
# HIVE_OAUTH_CLIENT_SECRET=
# HIVE_OAUTH_ISSUER=https://iam.example.com
# HIVE_OAUTH_API_AUDIENCE=magnus-api
# HIVE_OAUTH_SCOPE=openid profile email

# Hermes Agent pages, dashboard proxy and WebSocket bridge.
# MAGNUS_HERMES_ENABLED=false
# Reviewed installation/node/address/SSH host-key bindings for the Hermes proxy.
# HERMES_SSH_AUTHORIZATIONS_FILE=.magnus/hermes-ssh-authorizations.json
# Additional browser origins allowed to open the Hermes WebSocket bridge.
# HERMES_WEBSOCKET_ALLOWED_ORIGINS=https://magnus-backup.example.com
# Optional network allowlist for Hermes SSH targets (exact /32 or narrow subnets).
# HERMES_SSH_ALLOWED_CIDRS=192.0.2.10/32,10.0.0.0/24

# Dedicated unprivileged SSH identity for the terminal and Hermes proxy.
# DASHBOARD_SSH_USERNAME=magnus-proxy
# DASHBOARD_SSH_PRIVATE_KEY_PATH=/etc/magnus-ui/dashboard_proxy_ed25519

# ── Advanced ─────────────────────────────────────────────────────────────────

# SESSION_ISSUER=magnus-dashboard
# SESSION_AUDIENCE=magnus-dashboard-session
# REDIS_PREFIX=magnus-
# AUTH_RATE_LIMIT_LABEL_KEY=
# CONTROL_API_MAX_RESPONSE_BYTES=1048576
# Change to invalidate all existing local sessions without rotating secrets.
# LOCAL_SESSION_GENERATION=
# Server-only resource enrollment participant credential (32+ characters); must
# match the Control API. Never set it via NEXT_PUBLIC_*.
# RESOURCE_ENROLLMENT_DASHBOARD_SECRET=
# Password for the dashboard SSH identity; a restricted key is preferred.
# DASHBOARD_SSH_PASSWORD=

# ── Legacy and serializer-managed (prefer the settings above) ───────────────

# Base64 forms of the administrator credentials, written by deployment tooling.
# DASHBOARD_ADMIN_USERNAME_B64=
# DASHBOARD_ADMIN_PASSWORD_HASH_B64=
# DASHBOARD_ADMIN_CREDENTIAL_METADATA_B64=
# Former dashboard login, accepted only while migrating to DASHBOARD_ADMIN_*.
# DASHBOARD_LOGIN_USERNAME=
# DASHBOARD_LOGIN_PASSWORD=
# Expired opt-in that reused JWT_SECRET for sessions; leave false.
# ALLOW_LEGACY_SESSION_SECRET=false
# Build-time Control API URL; never put a secret in it.
# NEXT_PUBLIC_API_URL=https://magnus-api.example.com:4000
