{
  "name": "@hivemagnus/magnus-fleet-gateway",
  "version": "2.4.0",
  "private": true,
  "description": "Magnus fleet gateway: the separate service that holds the restricted SSH key and carries the browser web terminal over HTTP streaming.",
  "keywords": [
    "magnus",
    "fleet",
    "ssh",
    "terminal",
    "gateway"
  ],
  "license": "Apache-2.0",
  "author": "ChefTaco",
  "homepage": "https://github.com/ChefTaco/magnus/tree/main/services/fleet-gateway#readme",
  "bugs": {
    "url": "https://github.com/ChefTaco/magnus/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ChefTaco/magnus.git",
    "directory": "services/fleet-gateway"
  },
  "type": "module",
  "bin": {
    "magnus-fleet-gateway": "dist/cli.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "!dist/**/*.test.*",
    "README.md",
    "LICENSE",
    ".env.example"
  ],
  "engines": {
    "node": "^24.22.1 || ^26.13.0"
  },
  "scripts": {
    "build": "node -e \"const fs=require('node:fs');fs.rmSync('dist',{recursive:true,force:true});fs.rmSync('tsconfig.tsbuildinfo',{force:true})\" && tsc --build && node ../../packages/oathweave/scripts/link-into-consumer.mjs",
    "start": "node dist/cli.js start",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && vitest run",
    "test:ssh": "npm run build && vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@hivemagnus/magnus-oathweave": "2.4.0",
    "@hono/node-server": "^2.1.6",
    "hono": "4.13.16",
    "jose": "^6.2.13",
    "ssh2": "^1.17.0",
    "zod": "^4.6.7"
  },
  "bundleDependencies": [
    "@hivemagnus/magnus-oathweave"
  ],
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/ssh2": "^1.15.6",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  }
}
