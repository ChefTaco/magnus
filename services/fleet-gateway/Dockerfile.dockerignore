# Build context filter for services/fleet-gateway/Dockerfile (context: repo root).
# Only the root manifests, every workspace manifest (so `npm ci` can validate the lockfile) and the
# two workspaces this image bundles are sent.
**
!package.json
!package-lock.json
!apps/*/package.json
!packages/*/package.json
!services/*/package.json
!packages/oathweave/**
!services/fleet-gateway/**

**/node_modules
**/dist
**/*.tsbuildinfo
**/.env
**/.env.*
!**/.env.example
**/*.test.ts
services/fleet-gateway/test
