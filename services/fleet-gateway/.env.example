# Magnus fleet gateway. Required settings stop startup when missing.

# TLS is mandatory: the gateway has no plain HTTP listener.
TLS_CERT_PATH=/run/tls/server.crt
TLS_KEY_PATH=/run/tls/server.key
# FLEET_GATEWAY_BIND_HOST=0.0.0.0
# FLEET_GATEWAY_PORT=4310
# The name on the certificate, for `magnus-fleet-gateway healthcheck` (default localhost).
# FLEET_GATEWAY_TLS_NAME=fleet-gateway.example.com

# The exact browser origin of the console. Any other Origin is refused. There is no CORS.
FLEET_GATEWAY_PUBLIC_ORIGIN=https://console.example.com

# Oathweave, as on the Magnus server. The links must be the same as the server's.
OATHWEAVE_ISSUER=https://identity.example.com
OATHWEAVE_JWKS_URL=https://identity.example.com/api/v1/oauth/jwks
OATHWEAVE_USERINFO_URL=https://identity.example.com/api/v1/oauth/userinfo
MAGNUS_OATHWEAVE_IDENTITIES_JSON=[{"issuer":"https://identity.example.com","subject":"example-subject","localUserId":"alice","role":"ADMIN"}]

# The Magnus API. HTTPS only.
CONTROL_API_URL=https://magnus.example.com:4000
# CONTROL_API_CA_PATH=/run/tls/ca.pem

# Generate each with: openssl rand -hex 32. Every value here must differ.
# The server stores the SHA-256 digest of this one as FLEET_GATEWAY_TOKEN_SHA256.
FLEET_GATEWAY_API_TOKEN=
# The same value as RESOURCE_ENROLLMENT_DASHBOARD_SECRET on the server.
RESOURCE_ENROLLMENT_DASHBOARD_SECRET=

# The restricted SSH identity. The account should hold only what an operator's terminal needs.
FLEET_GATEWAY_SSH_USERNAME=deploy
FLEET_GATEWAY_SSH_PRIVATE_KEY_PATH=/run/secrets/fleet-gateway-ssh-key

# Approved host keys. The directory must be mode 0700 and the file 0600, owned by this service.
# FLEET_GATEWAY_KNOWN_HOSTS_FILE=/var/lib/fleet-gateway/known-hosts/known-hosts.json

# Audit the client address from X-Forwarded-For. Set true only behind an ingress that overwrites
# it with one address. Otherwise the socket peer is recorded.
# FLEET_GATEWAY_TRUST_FORWARDED_FOR=false

# Session limits. Each has a hard bound.
# FLEET_GATEWAY_IDLE_TIMEOUT_SECONDS=900
# FLEET_GATEWAY_MAX_LIFETIME_SECONDS=3600
# FLEET_GATEWAY_MAX_SESSIONS_PER_SUBJECT=3
# FLEET_GATEWAY_MAX_SESSIONS=32
