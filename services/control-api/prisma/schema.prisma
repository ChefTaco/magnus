  metadata       String    @default("{}")
  createdBy      String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([installationId, profileId, toolset])
  @@index([installationId])
  @@index([profileId])
  @@map("hermes_toolset_policies")
}

