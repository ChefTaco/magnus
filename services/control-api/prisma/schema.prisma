// ─── Prisma Schema — Magnus Fleet Management ───

generator client {
  provider = "prisma-client"
  output   = "../src/db/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Append-only database side of the root-owned release anti-rewind chain.
// Application routes never mutate these receipts; deployment tooling does.
model MagnusReleaseCanary {
  epoch            BigInt
  tokenSha256      String   @id @db.VarChar(64)
  acceptedCommit   String   @db.VarChar(40)
  sourceTreeSha256 String   @db.VarChar(64)
  createdAt        DateTime @default(now()) @db.Timestamptz(6)

  @@map("magnus_release_canaries")
  @@index([epoch])
}

// ─── Users & Auth ───

model User {
  id          String    @id @default(cuid())
  email       String    @unique
  name        String
  password    String
  role        UserRole  @default(VIEWER)
  active      Boolean   @default(true)
  lastLoginAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("users")
}

enum UserRole {
  ADMIN
  OPERATOR
  VIEWER
}

// ─── Nodes ───

model Node {
  id              String     @id @default(cuid())
  name            String     @unique
  hostname        String
  ipAddress       String
  port            Int        @default(4100)
  status          NodeStatus @default(PROVISIONING)
  os              String
  arch            String
  tags            String     @default("[]")
  metadata        String     @default("{}")
  token           String     @unique
  roleId          String?
  lastHeartbeatAt DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  role                Role?                @relation(fields: [roleId], references: [id], onDelete: SetNull)
  agent               Agent?
  healthSnapshots     HealthSnapshot[]
  gpuSnapshots        GpuSnapshot[]
  logs                LogEntry[]
  commands            RemoteCommand[]
  cronJobs            CronJob[]
  cronExecutions      CronJobExecution[]
  filePatches         FilePatchTask[]
  skillInstalls       SkillInstallation[]
  rolloutTargets      RolloutTarget[]
  roleApplications    RoleApplication[]
  notifications       Notification[]
  alertViolations     AlertViolation[]
  alertConditionStates AlertConditionState[]
  driftScans          DriftScan[]
  anomalyEvents       AnomalyEvent[]
  hermesInstallations HermesInstallation[]
  ardentInstallation ArdentInstallation?
  resourceEnrollment ResourceEnrollment?
  ardentScopeEnrollment ArdentScopeEnrollment?
  admissionFence AdmissionFence?
  resourceParticipantWork ResourceParticipantWork[]
  engineeringMetricSamples EngineeringMetricSample[]

  @@index([status])
  @@index([ipAddress])
  @@index([lastHeartbeatAt])
  @@index([roleId])
  @@map("nodes")
}

// Node-local Ardent remains the authority for tasks, sessions and artifacts.
// These rows contain only fleet references and bounded observed status.
model ArdentInstallation {
  id          String   @id @default(cuid())
  nodeId      String   @unique
  owner       String?
  version     String?
  installed   Boolean  @default(false)
  reachable   Boolean  @default(false)
  error       String?
  observedAt  DateTime?
  checkedAt   DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  node     Node            @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  profiles ArdentProfile[]

  @@index([reachable, checkedAt])
  @@map("ardent_installations")
}

model ArdentProfile {
  id              String   @id @default(cuid())
  installationId  String
  name            String
  displayName     String
  backend         String?
  apiPort         Int?
  running         Boolean  @default(false)
  a2aEnabled      Boolean  @default(false)
  telegramEnabled Boolean  @default(false)
  error           String?
  observedAt      DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  installation ArdentInstallation @relation(fields: [installationId], references: [id], onDelete: Cascade)

  @@unique([installationId, name])
  @@index([running, observedAt])
  @@map("ardent_profiles")
}

enum NodeStatus {
  ONLINE
  OFFLINE
  DEGRADED
  PROVISIONING
  DECOMMISSIONED
}

// ─── Agent ───

model Agent {
  id           String      @id @default(cuid())
  nodeId       String      @unique
  version      String
  status       AgentStatus @default(RUNNING)
  pid          Int?
  startedAt    DateTime    @default(now())
  lastCheckIn  DateTime    @default(now())
  capabilities String      @default("[]")

  node Node @relation(fields: [nodeId], references: [id], onDelete: Cascade)

  @@map("agents")
}

enum AgentStatus {
  RUNNING
  STOPPED
  UPDATING
  ERROR
}

// ─── Hermes Agent Runtime ───

model HermesInstallation {
  id               String    @id @default(cuid())
  nodeId           String?
  hostname         String
  sshPort          Int       @default(22)
  displayName      String?
  installMode      String    @default("unknown") // unknown | official-script | pip | git | existing
  hermesHome       String    @default("~/.hermes")
  hermesBin        String    @default("hermes")
  version          String?
  status           String    @default("unknown") // unknown | not_installed | detected | needs_setup | running | degraded | error
  gatewayStatus    String    @default("unknown")
  dashboardHost    String    @default("127.0.0.1")
  dashboardPort    Int       @default(9119)
  dashboardStatus  String    @default("unknown")
  apiServerEnabled Boolean   @default(false)
  apiServerHost    String    @default("127.0.0.1")
  apiServerPort    Int?
  lastDetectedAt   DateTime?
  lastSyncedAt     DateTime?
  metadata         String    @default("{}")
  rawStatus        String    @default("{}")
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  node     Node?                @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  profiles HermesProfile[]
  jobs     HermesOperationJob[]

  @@unique([hostname, hermesHome])
  @@index([nodeId])
  @@index([status])
  @@index([hostname])
  @@map("hermes_installations")
}

model HermesProfile {
  id                      String    @id @default(cuid())
  installationId          String
  name                    String
  description             String    @default("")
  profileHome             String    @default("")
  isDefault               Boolean   @default(false)
  providerSummary         String?
  modelSummary            String?
  distribution            String?
  gatewayStatus           String    @default("unknown")
  apiServerEnabled        Boolean   @default(false)
  apiServerHost           String    @default("127.0.0.1")
  apiServerPort           Int?
  apiServerKeyFingerprint String?
  capabilities            String    @default("{}")
  envStatus               String    @default("{}")
  metadata                String    @default("{}")
  lastSyncedAt            DateTime?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  installation HermesInstallation   @relation(fields: [installationId], references: [id], onDelete: Cascade)
  jobs         HermesOperationJob[]

  @@unique([installationId, name])
  @@index([installationId])
  @@index([gatewayStatus])
  @@map("hermes_profiles")
}

model HermesOperationJob {
  id             String    @id @default(cuid())
  type           String
  status         String    @default("queued") // queued | running | completed | failed | cancelled
  installationId String?
  profileId      String?
  targetHost     String?
  createdBy      String
  steps          String    @default("[]")
  result         String?
  error          String?
  metadata       String    @default("{}")
  startedAt      DateTime  @default(now())
  completedAt    DateTime?

  installation HermesInstallation? @relation(fields: [installationId], references: [id], onDelete: SetNull)
  profile      HermesProfile?      @relation(fields: [profileId], references: [id], onDelete: SetNull)

  @@index([type])
  @@index([status])
  @@index([installationId])
  @@index([profileId])
  @@index([createdBy])
  @@index([startedAt])
  @@map("hermes_operation_jobs")
}

// ─── Health ───

model HealthSnapshot {
  id               String   @id @default(cuid())
  nodeId           String
  timestamp        DateTime @default(now())
  cpuUsagePercent  Float
  cpuCores         Int
  cpuLoadAverage   String
  memoryTotalBytes BigInt
  memoryUsedBytes  BigInt
  memoryPercent    Float
  swapTotalBytes   BigInt
  swapUsedBytes    BigInt
  disks            String
  network          String
  services         String
  wazuh            String   @default("{}")
  systemUpdates    String   @default("{}")
  cockpitAvailable Boolean  @default(false)
  source           String   @default("system-probe")

  node Node @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  anomalyEvents AnomalyEvent[]

  @@index([nodeId, timestamp])
  @@map("health_snapshots")
}

model GpuSnapshot {
  id                    String   @id @default(cuid())
  nodeId                String
  sampledAt             DateTime
  sampleIntervalSeconds Int      @default(30)
  status                String   @default("unavailable")
  devices               String
  maxUtilizationPercent Float?
  maxFanPercent         Float?

  node Node @relation(fields: [nodeId], references: [id], onDelete: Cascade)

  @@unique([nodeId, sampledAt])
  @@index([nodeId, sampledAt])
  @@map("gpu_snapshots")
}

// ─── Logs ───

model LogEntry {
  id        String   @id @default(cuid())
  nodeId    String
  source    String
  level     String
  message   String
  metadata  String   @default("{}")
  timestamp DateTime @default(now())

  node Node @relation(fields: [nodeId], references: [id], onDelete: Cascade)

  @@index([nodeId, timestamp])
  @@index([level])
  @@index([source])
  @@map("log_entries")
}

// ─── Remote Commands ───

model RemoteCommand {
  id               String        @id @default(cuid())
  nodeId           String
  command          String
  args             String        @default("[]")
  workingDirectory String?
  environment      String        @default("{}")
  timeoutSeconds   Int           @default(300)
  status           CommandStatus @default(PENDING)
  riskLevel        String        @default("low")
  idempotencyKey   String        @unique
  correlationId    String?
  createdBy        String
  approvedBy       String?
  executionDeadline DateTime?
  coordinationJson String?
  createdAt        DateTime      @default(now())
  startedAt        DateTime?
  completedAt      DateTime?

  node   Node           @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  result CommandResult?

  @@index([nodeId, status])
  @@index([idempotencyKey])
  @@index([correlationId])
  @@map("remote_commands")
}

enum CommandStatus {
  PENDING
  QUEUED
  RUNNING
  COMPLETED
  FAILED
  TIMEOUT
  CANCELLED
}

model CommandResult {
  id         String  @id @default(cuid())
  commandId  String  @unique
  exitCode   Int
  stdout     String
  stderr     String
  durationMs Int
  truncated  Boolean @default(false)

  command RemoteCommand @relation(fields: [commandId], references: [id], onDelete: Cascade)

  @@map("command_results")
}

// ─── Cron Jobs ───

model CronJob {
  id               String        @id @default(cuid())
  nodeId           String
  name             String
  description      String        @default("")
  schedule         String
  command          String
  args             String        @default("[]")
  workingDirectory String?
  environment      String        @default("{}")
  timeoutSeconds   Int           @default(600)
  status           CronJobStatus @default(ACTIVE)
  lastRunAt        DateTime?
  lastRunExitCode  Int?
  nextRunAt        DateTime?
  createdBy        String
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  node       Node               @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  executions CronJobExecution[]

  @@unique([nodeId, name])
  @@map("cron_jobs")
}

enum CronJobStatus {
  ACTIVE
  PAUSED
  ERROR
}

model CronJobExecution {
  id          String    @id @default(cuid())
  cronJobId   String
  nodeId      String
  startedAt   DateTime  @default(now())
  completedAt DateTime?
  exitCode    Int?
  stdout      String
  stderr      String
  durationMs  Int?

  cronJob CronJob @relation(fields: [cronJobId], references: [id], onDelete: Cascade)
  node    Node    @relation(fields: [nodeId], references: [id], onDelete: Cascade)

  @@index([cronJobId, startedAt])
  @@map("cron_job_executions")
}

// ─── File Sync ───

model FilePatchTask {
  id               String    @id @default(cuid())
  nodeId           String
  filePath         String
  direction        String    @default("push")
  content          String?
  checksum         String?
  previousChecksum String?
  status           String    @default("pending")
  error            String?
  createdBy        String
  createdAt        DateTime  @default(now())
  completedAt      DateTime?

  node Node @relation(fields: [nodeId], references: [id], onDelete: Cascade)

  @@index([nodeId, status])
  @@map("file_patch_tasks")
}

// ─── Skills ───

model SkillRegistryEntry {
  id            String   @id @default(cuid())
  slug          String   @unique
  displayName   String
  description   String   @default("")
  author        String   @default("")
  source        String   @default("local")
  sourceUrl     String?
  entryPoint    String   @default("run.sh")
  dependencies  String   @default("[]")
  metadata      String   @default("{}")
  latestVersion String?
  status        String   @default("active")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  versions      SkillVersion[]
  tags          SkillTag[]
  installations SkillInstallation[]

  @@index([status])
  @@index([source])
  @@map("skill_registry_entries")
}

model SkillVersion {
  id          String   @id @default(cuid())
  skillId     String
  version     String
  changelog   String   @default("")
  contentHash String
  files       String   @default("[]")
  entryPoint  String   @default("run.sh")
  sizeBytes   Int      @default(0)
  publishedBy String   @default("system")
  createdAt   DateTime @default(now())

  skill SkillRegistryEntry @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([skillId, version])
  @@index([skillId, createdAt])
  @@map("skill_versions")
}

model SkillTag {
  id        String   @id @default(cuid())
  skillId   String
  tag       String
  versionId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  skill SkillRegistryEntry @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([skillId, tag])
  @@map("skill_tags")
}

model SkillInstallation {
  id              String    @id @default(cuid())
  skillName       String
  nodeId          String
  version         String
  status          String    @default("available")
  registryEntryId String?
  versionHash     String?
  bundleSha256    String?
  treeSha256      String?
  workflowCommandId       String? @unique
  workflowRequestSha256   String?
  workflowReceiptSha256   String? @unique
  installedAt     DateTime?
  error           String?

  node          Node                @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  registryEntry SkillRegistryEntry? @relation(fields: [registryEntryId], references: [id], onDelete: SetNull)

  @@unique([skillName, nodeId])
  @@index([registryEntryId])
  @@map("skill_installations")
}

// ─── Rollout / Execution Runs ───

model ExecutionRun {
  id              String    @id @default(cuid())
  type            String
  rolloutStrategy String    @default("all_at_once")
  status          String    @default("created")
  totalNodes      Int       @default(0)
  completedNodes  Int       @default(0)
  failedNodes     Int       @default(0)
  metadata        String    @default("{}")
  createdBy       String
  createdAt       DateTime  @default(now())
  startedAt       DateTime?
  completedAt     DateTime?

  targets RolloutTarget[]

  @@index([status])
  @@map("execution_runs")
}

model RolloutTarget {
  id          String    @id @default(cuid())
  rolloutId   String
  nodeId      String
  status      String    @default("pending")
  error       String?
  startedAt   DateTime?
  completedAt DateTime?

  commandId   String? @unique
  evidence    String @default("{}")

  rollout ExecutionRun @relation(fields: [rolloutId], references: [id], onDelete: Cascade)
  node    Node         @relation(fields: [nodeId], references: [id], onDelete: Cascade)

  @@unique([rolloutId, nodeId])
  @@map("rollout_targets")
}

// ─── Library ───

model LibraryCategory {
  id          String   @id @default(cuid())
  name        String   @unique
  description String   @default("")
  color       String   @default("#6366f1")
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  files LibraryFile[]

  @@map("library_categories")
}

model LibraryFile {
  id         String   @id @default(cuid())
  name       String
  fileName   String
  mimeType   String   @default("text/markdown")
  content    String   @default("")
  sizeBytes  Int      @default(0)
  categoryId String?
  tags       String   @default("[]")
  createdBy  String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  category LibraryCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([categoryId])
  @@index([name])
  @@map("library_files")
}

// ─── Roles ───

model Role {
  id                 String   @id @default(cuid())
  name               String   @unique
  description        String   @default("")
  libraryFileIds     String   @default("[]")
  skillNames         String   @default("[]")
  aptPackages        String   @default("[]")
  npmPackages        String   @default("[]")
  envConfig          String   @default("{}")
  dockerEnabled      Boolean  @default(false)
  dockerNonRoot      Boolean  @default(false)
  dockerImage        String?
  dockerVolumes      String   @default("[]")
  firewallEnabled    Boolean  @default(false)
  firewallMode       String   @default("restrictive")
  firewallAllowRules String   @default("[]")
  status             String   @default("active")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  nodes        Node[]
  applications RoleApplication[]

  @@map("roles")
}

model RoleApplication {
  id          String    @id @default(cuid())
  nodeId      String
  roleId      String
  action      String
  status      String    @default("pending")
  steps       String    @default("[]")
  error       String?
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())

  node Node @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@index([nodeId])
  @@index([roleId])
  @@index([status])
  @@map("role_applications")
}

// ─── Notifications ───

model Notification {
  id        String    @id @default(cuid())
  type      String // node.offline | node.degraded | node.recovered | command.failed | deploy.failed | upgrade.failed
  severity  String    @default("warning") // info | warning | critical
  title     String
  message   String
  nodeId    String?
  nodeName  String?
  sourceRef String? // e.g. commandId, deployId
  metadata  String    @default("{}") // JSON blob for extra context
  isRead    Boolean   @default(false)
  readAt    DateTime?
  createdAt DateTime  @default(now())

  node Node? @relation(fields: [nodeId], references: [id], onDelete: SetNull)

  @@index([isRead, createdAt])
  @@index([nodeId, createdAt])
  @@index([type, createdAt])
  @@index([type, nodeId, sourceRef, createdAt])
  @@map("notifications")
  suppressedBy String?

}

// ─── Notification Preferences ───

model NotificationPreference {
  id          String   @id @default(cuid())
  userId      String
  channel     String   @default("in_app") // in_app | email | webhook
  category    String // node.offline | node.degraded | command.failed | deploy.* | ai.* | etc.
  enabled     Boolean  @default(true)
  minSeverity String   @default("info") // info | warning | critical
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, channel, category])
  @@index([userId])
  @@map("notification_preferences")
}

// ─── Webhook Endpoints ───

model WebhookEndpoint {
  id        String   @id @default(cuid())
  name      String
  url       String
  type      String   @default("generic") // generic | slack | discord
  secret    String? // AES-256-GCM envelope containing the HMAC signing secret
  events    String   @default("[]") // JSON array of event patterns
  headers   String // AES-256-GCM envelope containing JSON extra headers
  active    Boolean  @default(true)
  retries   Int      @default(3)
  timeoutMs Int      @default(10000)
  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  deliveries WebhookDelivery[]

  @@index([active])
  @@map("webhook_endpoints")
}

model WebhookDelivery {
  id          String    @id @default(cuid())
  endpointId  String
  event       String
  payload     String // JSON
  status      String    @default("pending") // pending | success | failed
  httpStatus  Int?
  response    String? // Response body (truncated)
  error       String?
  attempts    Int       @default(0)
  deliveredAt DateTime?
  createdAt   DateTime  @default(now())

  endpoint WebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)

  @@index([endpointId, createdAt])
  @@index([status])
  @@map("webhook_deliveries")
}

// ─── Health Alert Rules ───

model AlertRule {
  id              String   @id @default(cuid())
  name            String
  metric          String // cpu | memory | disk | swap
  operator        String // gt | lt | gte | lte | eq
  threshold       Float
  durationSeconds Int      @default(0) // Must exceed for N seconds (0 = instant)
  severity        String   @default("warning") // info | warning | critical
  nodeFilter      String   @default("*") // "*" = all, or comma-separated node IDs/tags
  active          Boolean  @default(true)
  cooldownMinutes Int      @default(15) // Don't re-fire for N minutes
  createdBy       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  violations AlertViolation[]
  conditionStates AlertConditionState[]

  @@index([active])
  @@index([metric])
  @@map("alert_rules")
}

model AlertConditionState {
  ruleId         String
  nodeId         String
  breachedAt     DateTime
  lastObservedAt DateTime
  lastValue      Float

  rule AlertRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  node Node      @relation(fields: [nodeId], references: [id], onDelete: Cascade)

  @@id([ruleId, nodeId])
  @@index([nodeId])
  @@map("alert_condition_states")
}

model AlertViolation {
  id         String    @id @default(cuid())
  ruleId     String
  nodeId     String
  nodeName   String?
  metric     String
  value      Float
  threshold  Float
  severity   String
  status     String    @default("active") // active | resolved
  resolvedAt DateTime?
  createdAt  DateTime  @default(now())

  rule AlertRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  node Node      @relation(fields: [nodeId], references: [id], onDelete: Cascade)

  @@index([ruleId, status])
  @@index([nodeId, status])
  @@index([status, createdAt])
  @@map("alert_violations")
}

// ─── Batch Deploy Jobs ───

model DeployJob {
  id          String    @id @default(cuid())
  type        String // 'deploy' | 'upgrade'
  status      String    @default("running") // running | completed | partial_failure
  concurrency Int       @default(5)
  targets     String // JSON array of target configs
  results     String? // JSON array of per-target results
  startedAt   DateTime  @default(now())
  completedAt DateTime?
  createdBy   String

  @@index([status])
  @@index([createdBy])
  @@map("deploy_jobs")
}

// ─── Drift Scans ───

model DriftScan {
  id        String   @id @default(cuid())
  nodeId    String
  roleId    String?
  status    String // 'clean' | 'drifted' | 'error'
  findings  String // JSON array of drift items
  scannedAt DateTime @default(now())

  node Node @relation(fields: [nodeId], references: [id], onDelete: Cascade)

  @@index([nodeId])
  @@index([status])
  @@map("drift_scans")
}

// ─── Anomaly Detection ───

model AnomalyEvent {
  id              String    @id @default(cuid())
  nodeId          String
  healthSnapshotId String?
  metric          String // 'cpu' | 'memory' | 'disk' | 'swap' | 'network_rx' | 'network_tx'
  value           Float
  zScore          Float
  mean            Float
  stdDev          Float
  severity        String    @default("warning") // info | warning | critical (resource-pressure policy)
  resolved        Boolean   @default(false)
  resolvedAt      DateTime?
  firstSeenAt     DateTime  @default(now())
  lastSeenAt      DateTime  @default(now())
  occurrenceCount Int       @default(1)
  createdAt       DateTime  @default(now())

  node Node @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  healthSnapshot HealthSnapshot? @relation(fields: [healthSnapshotId], references: [id], onDelete: Restrict)

  @@index([nodeId, createdAt])
  @@index([resolved, createdAt])
  @@index([metric, createdAt])
  @@index([nodeId, metric, resolved])
  @@index([healthSnapshotId])
  @@map("anomaly_events")
}

// ─── AI Fleet Assistant ───

model AiConversation {
  id                  String   @id @default(cuid())
  title               String   @default("New conversation")
  type                String   @default("chat") // 'chat' | 'heartbeat' | 'analysis'
  nodeId              String? // If analysis is node-specific
  parentId            String?
  forkedFromMessageId String?
  status              String   @default("active") // 'active' | 'archived'
  summary             String? // Auto-generated summary for context window management
  createdBy           String   @default("system")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  parent   AiConversation?  @relation("AiConversationForks", fields: [parentId], references: [id], onDelete: SetNull)
  children AiConversation[] @relation("AiConversationForks")
  messages AiMessage[]

  @@index([type, createdAt])
  @@index([status, createdAt])
  @@index([nodeId])
  @@index([parentId, updatedAt])
  @@index([forkedFromMessageId])
  @@map("ai_conversations")
}

model AiMessage {
  id                 String    @id @default(cuid())
  conversationId     String
  role               String // 'system' | 'user' | 'assistant' | 'tool'
  content            String
  toolCalls          String    @default("[]") // JSON array of tool call results
  thinking           String?
  structuredAnalysis String?
  tokenCount         Int       @default(0)
  isRead             Boolean   @default(false)
  readAt             DateTime?
  pendingApproval    String? // JSON: tool call awaiting human approval
  createdAt          DateTime  @default(now())

  conversation AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([role, isRead])
  @@map("ai_messages")
}

// ─── AI Memory ───

model AiMemory {
  id         String    @id @default(cuid())
  key        String    @unique // Deduplication key (e.g. 'node:web-01:disk_pattern')
  category   String    @default("general") // 'general' | 'node' | 'pattern' | 'preference'
  content    String // The memory content
  source     String    @default("heartbeat") // Where it came from
  relevance  Float     @default(1.0) // Decay over time
  accessedAt DateTime? // Last time this memory was accessed/injected
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([category])
  @@index([relevance])
  @@map("ai_memories")
}

// Legacy persisted dashboard rows retained to avoid a destructive data migration.
// No runtime route or dashboard page uses this model.

model AiDashboard {
  id          String   @id @default(cuid())
  name        String
  description String?
  layout      String   @default("[]") // JSON array of WidgetSpec objects
  createdBy   String   @default("system")
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([createdBy])
  @@map("ai_dashboards")
}

// ─── A2A (Agent-to-Agent) Tasks ───

model A2ATask {
  id          String   @id @default(cuid())
  title       String   @default("")
  description String   @default("")
  status      String   @default("submitted") // submitted | working | input-required | completed | failed | canceled
  fromAgent   String   @default("user") // Requesting agent/user
  toAgent     String   @default("magnus") // Target agent
  input       String   @default("{}") // JSON input payload
  output      String? // JSON output / result
  artifacts   String   @default("[]") // JSON array of artifact references
  history     String   @default("[]") // JSON array of status change log
  metadata    String   @default("{}") // JSON extra context
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status])
  @@index([fromAgent])
  @@index([toAgent])
  @@map("a2a_tasks")
}

// ─── Auto-Remediation ───

model RemediationRule {
  id                String   @id @default(cuid())
  name              String   @unique
  description       String   @default("")
  metric            String   @default("*") // cpu | memory | disk | swap | *
  severityThreshold String   @default("critical") // warning | critical
  agentDefinitionId String // Versioned runbook; legacy values remain record-only
  input             String   @default("") // Reviewed runbook configuration JSON
  cooldownMinutes   Int      @default(60)
  maxConcurrentRuns Int      @default(1)
  nodeFilter        String? // Optional node ID or pattern filter
  enabled           Boolean  @default(true)
  createdBy         String   @default("system")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  executions RemediationExecution[]

  @@index([enabled, metric])
  @@map("remediation_rules")
}

model RemediationExecution {
  id             String    @id @default(cuid())
  ruleId         String
  anomalyEventId String
  nodeId         String
  orchestraRunId String? // Orchestra run ID (set after trigger)
  status         String    @default("triggered") // pending_approval | approving | running | completed | failed | skipped; legacy triggered
  input          String    @default("") // Immutable approval plan JSON
  output         String? // Result/error message
  triggeredAt    DateTime  @default(now())
  completedAt    DateTime?

  rule RemediationRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@index([ruleId, triggeredAt])
  @@index([nodeId, triggeredAt])
  @@index([status])
  @@map("remediation_executions")
}

// ── Scheduled AI Operations ──

model AiScheduledOp {
  id          String    @id @default(cuid())
