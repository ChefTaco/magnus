  nonce       String   @id
  collectorId String
  expiresAt   DateTime
  createdAt   DateTime @default(now())

  @@index([expiresAt])
  @@map("security_fusion_nonces")
}

model SecurityFusionInvestigation {
  id        String   @id @default(cuid())
  caseId    String
  revision  Int
  authorId  String
  draftJson String
  createdAt DateTime @default(now())

  @@unique([caseId, revision])
  @@index([caseId, createdAt])
  @@map("security_fusion_investigations")
}

model SecurityFusionAction {
  id                String    @id @default(cuid())
  caseId            String
  nodeId            String
  kind              String
  serviceName       String?
  isolationMinutes  Int?
  rationale         String
  rollbackPlan      String
  previewJson       String
  previewSha256     String
  status            String    @default("previewed")
  requestedBy       String
  approvedBy        String?
  approvalTokenHash String?
  approvalExpiresAt DateTime?
  executedAt        DateTime?
  verificationDeadline DateTime?
  resultJson        String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([caseId, createdAt])
  @@index([status, approvalExpiresAt])
  @@map("security_fusion_actions")
}

model SecurityFusionActionApproval {
  id            String    @id @default(cuid())
  actionId      String    @unique
  previewSha256 String
  tokenHash     String
  status        String    @default("pending")
  requestedBy   String
  decidedBy     String?
