  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  dispatchedAt    DateTime?

  @@unique([actionId, operation])
  @@unique([remoteCommandId])
  @@index([status, nextAttemptAt])
  @@map("security_fusion_command_outbox")
}

model SecurityFusionDelivery {
  id          String   @id @default(cuid())
  caseId      String
  revisionKey String   @unique
  channel     String
  status      String
  externalId  String?
  error       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([caseId, createdAt])
  @@map("security_fusion_deliveries")
}

// Read-only probes configured by the operator; credentials remain in server env.
model ApplicationObservation {
  id String @id
  projectId String
  serviceId String
  nodeId String
  status String @default("unknown")
  resultJson String @default("{}")
  observedAt DateTime?
  @@index([nodeId])
  @@map("application_observations")
}

// Append-only samples emitted by Control API-owned collectors. Callers never
// submit these rows through the engineering assessment API.
model EngineeringMetricSample {
  id             String   @id @default(cuid())
  applicationId  String
  nodeId         String
  metric         String
  sourceKey      String
  unit           String
  value          Float
  observedAt     DateTime
  probeContractSha256 String
  method         String
  path           String
  httpStatus     Int
  evidenceSha256 String
  createdAt      DateTime @default(now())

  node Node @relation(fields: [nodeId], references: [id], onDelete: Cascade)

  @@unique([applicationId, metric, sourceKey, observedAt])
  @@index([applicationId, metric, observedAt])
  @@index([nodeId, metric, observedAt])
  @@map("engineering_metric_samples")
}

// Control API-owned results from disposable recovery exercises. The collector
// computes all digests; public engineering routes are read-only.
model EngineeringRecoveryExercise {
  id                     String   @id
  targetId               String
  scenario               String
  startedAt              DateTime
  recoveredAt            DateTime
  recoveryPointAt        DateTime
  rtoObjectiveSeconds    Int
  rpoObjectiveSeconds    Int
  beforeStateSha256      String
  beforeTaskSha256       String
  beforeArtifactSha256   String
  afterStateSha256       String
  afterTaskSha256        String
  afterArtifactSha256    String
  beforeEvidenceJson     String
  afterEvidenceJson      String
  runtimeEvidenceJson    String
  directEvidenceSha256   String
  runnerIssuer           String
  runnerKeyId            String
  runnerPublicKeySha256  String
  runnerNonce            String   @unique
  runnerIssuedAt         DateTime
  runnerExpiresAt        DateTime
  runnerExerciseContractSha256 String
  runnerReceiptJson      String
  runnerReceiptSha256    String   @unique
  inventorySnapshotSha256 String
  recordSha256           String
  createdAt              DateTime @default(now())

  @@index([targetId, createdAt])
  @@index([scenario, createdAt])
  @@map("engineering_recovery_exercises")
}

model MaintenanceWindow {
  id String @id @default(cuid())
  reason String
  nodeIds String
  serviceIds String @default("[]")
  actorId String
  startsAt DateTime
  endsAt DateTime
  cancelledAt DateTime?
  createdAt DateTime @default(now())
  @@index([startsAt, endsAt])
  @@map("maintenance_windows")
}

model IncidentLesson {
  id String @id @default(cuid())
  incidentId String
  nodeId String?
  symptom String
  cause String
  runbookVersion String
  evidenceIds String
  reviewedBy String
  expiresAt DateTime
  supersededAt DateTime?
  memoryId String?
  createdAt DateTime @default(now())
  @@index([incidentId, expiresAt])
  @@map("incident_lessons")
}

// Durable outbound security observations. Retained on Magnus after extraction.
model SecurityExportOutbox {
 id String @id
 payload String
 createdAt DateTime @default(now())
 deliveredAt DateTime?
 attempts Int @default(0)
 nextAttemptAt DateTime @default(now())
 lastError String?
 @@index([deliveredAt, nextAttemptAt])
 @@map("security_export_outbox")
}

// Durable last observed service state; transition and outbox commit together.
model SecurityServiceState {
  nodeId String
  serviceName String
  status String
  observationId String
  observedAt DateTime
  @@id([nodeId, serviceName])
  @@map("security_service_states")
}

/// Immutable native-Telegram decisions, committed with provider admission state.
model TeamApprovalDecision {
  decisionId       String   @id
  proposalId       String   @unique
  proposalRevision Int
  planSha256       String
  decision         String
  assertionSha256  String
  actorBindingSha256 String
  executionId      String?  @unique
  decidedAt        DateTime
  expiresAt        DateTime
  createdAt        DateTime @default(now())

  @@map("team_approval_decisions")
}

/// Monotonic fencing generations allocated by the service; node admission owns execution.
model CommandResourceFence {
  resourceKey String @id
  generation BigInt @default(0)
  @@map("command_resource_fences")
}

/// Durable finite-command ownership. Expiry never releases uncertain effects.
model CommandResourceLease {
  id String @id
  nodeId String
  resourceKey String
  serviceUnit String?
  commandId String @unique
  ownerActor String
  requestSha256 String
  coordinationJson String
  completionClass String?
  completionRegistryVersion Int?
  completionRegistrySha256 String?
  completionDescriptorId String?
  completionOccurrenceId String?
  completionSpecSha256 String?
  state String @default("reserved")
  directCommand Boolean @default(false)
  deadline DateTime
  acquiredAt DateTime @default(now())
  dispatchedAt DateTime?
  settledAt DateTime?
  settlement String?
  evidenceSha256 String?
  @@index([nodeId, state])
  @@index([resourceKey, state])
  @@map("command_resource_leases")
}

/// Global monotonic generations for repository, provider and GPU ownership.
model SharedResourceFence {
  resourceKey String @id
  generation BigInt @default(1)
  updatedAt DateTime @updatedAt
  @@map("shared_resource_fences")
}

/// Durable cross-host ownership. Deadlines and unknown outcomes never release a lease.
model SharedResourceLease {
  id String @id
  missionRootId String
  missionRevision Int
  taskId String
  operationId String @unique
  requestSha256 String
  actionClass String
  ownerActor String
  callerKind String
  delegationId String?
  missionIssuer String
  missionKeyId String
  missionAssertionSha256 String
  missionAssertionJson String
  resourceSetBinding String
  state String @default("reserved")
  deadline DateTime
  acquiredAt DateTime @default(now())
  startedAt DateTime?
  settledAt DateTime?
  settlement String?
  evidenceSha256 String?
  settlementRecordSha256 String? @unique
  terminalEvidenceJson String?
  reconciliationDecisionId String? @unique
  reconciliationJson String?
  resources SharedResourceLeaseResource[]
  @@index([missionRootId, missionRevision])
  @@index([taskId, state])
  @@map("shared_resource_leases")
}

/// Exact resources and generations acquired atomically for one shared operation.
model SharedResourceLeaseResource {
  leaseId String
  resourceKey String
  fenceGeneration BigInt
  state String @default("reserved")
  lease SharedResourceLease @relation(fields: [leaseId], references: [id], onDelete: Restrict)
  @@id([leaseId, resourceKey])
  @@unique([resourceKey, fenceGeneration])
  @@index([resourceKey, state])
  @@map("shared_resource_lease_resources")
}

/// One-way admission barrier. Epoch and every reservation share the node advisory lock.
model ResourceEnrollment {
  nodeId String @id
  nodeFqdn String
  state String @default("legacy")
  epoch Int @default(0)
  barrierId String?
  startedBy String?
  startedAt DateTime?
  enrolledAt DateTime?
  updatedAt DateTime @updatedAt
  node Node @relation(fields: [nodeId], references: [id], onDelete: Restrict)
  participants ResourceDrainParticipant[]
  @@map("resource_enrollments")
}

/// One-way Ardent-only admission while whole-node scheduler drain remains open.
model ArdentScopeEnrollment {
  nodeId String @id
  nodeFqdn String
  epoch Int
  barrierId String
  decisionId String @unique
  assertionJson String
  evidenceSha256 String
  activatedAt DateTime @default(now())
  node Node @relation(fields: [nodeId], references: [id], onDelete: Restrict)
  @@map("ardent_scope_enrollments")
}

/// Node admission plus a conservative Control API global shared-lease pause.
/// External writers and OS schedules remain outside coverage.
model AdmissionFence {
  nodeId String @id
  nodeFqdn String
  releaseId String
  closedAt DateTime @default(now())
  node Node @relation(fields: [nodeId], references: [id], onDelete: Restrict)
  @@map("council_admission_fences")
}

model ResourceDrainParticipant {
  nodeId String
  participant String
  epoch Int
  barrierId String
  challengeId String
  challengeExpiresAt DateTime
  status String @default("pending")
  evidenceSha256 String?
  receiptJson String?
  verifiedAt DateTime?
  enrollment ResourceEnrollment @relation(fields: [nodeId], references: [nodeId], onDelete: Restrict)
  @@id([nodeId, participant])
  @@map("resource_drain_participants")
}

/// No TTL release: a lost process or SSH close cannot prove descendant termination.
model ResourceParticipantWork {
  workId String @id
  nodeId String
  participant String
  ownerId String
  kind String
  epoch Int
  barrierId String?
  /// Reservation-time canonical inventory identity. Historical rows remain null.
  nodeFqdn String?
  /// Immutable digest of reservation identity and action kind, not arbitrary
  /// shell contents. Historical rows remain null and cannot use v1 reconciliation.
  requestSha256 String?
  /// Exact operation/request bytes digest for bounded work. External sessions
  /// bind their admission descriptor but remain ineligible for terminal release.
  operationSha256 String?
  /// Monotonic generation allocated for this participant/node namespace.
  fence BigInt?
  /// Last instant at which a supervised descendant may begin.
  deadline DateTime?
  state String @default("reserved")
  createdAt DateTime @default(now())
  startedAt DateTime?
  settledAt DateTime?
  settlement String?
  evidenceSha256 String?
  reconciliationDecisionId String? @unique
  reconciliationJson String?
  nodeSessionReceiptSha256 String? @unique
  nodeSessionReceiptJson String?
  node Node @relation(fields: [nodeId], references: [id], onDelete: Restrict)
  @@index([nodeId, participant, state])
  @@map("resource_participant_work")
}

// Explicit opt-in finite cron authority. Historical CronJob rows remain legacy.
model ManagedCronDefinition {
  cronJobId String @id
  nodeId String
  jobId String
  revision Int
  specSha256 String
  specJson String
  enabled Boolean @default(false)
  acknowledgementProtocolVersion Int?
  stageCommandSha256 String?
  stageReceiptSha256 String?
  stageAcknowledgedAt DateTime?
  activationCommandSha256 String?
  activationReceiptSha256 String?
  activationAcknowledgedAt DateTime?
  acknowledgedJobId String?
  acknowledgedRevision Int?
  acknowledgedSpecSha256 String?
  acknowledgedSpecJson String?
  expiresAt DateTime
  createdAt DateTime @default(now())
  @@unique([nodeId, jobId])
  @@map("managed_cron_definitions")
}

model ManagedCronOccurrence {
  id String @id
  cronJobId String
  nodeId String
  revision Int
  specSha256 String
  scheduledAt DateTime
  deadline DateTime
  commandId String @unique
  state String @default("admitting")
  admissionJson String?
  createdAt DateTime @default(now())
  @@index([nodeId, state])
  @@map("managed_cron_occurrences")
}
