/// Per-installation skill pin — which skill bundles should be present on which
/// installation/profile. Reconciled by magnus-agent via `hermes skills install`.
model HermesSkillAssignment {
  id             String    @id @default(cuid())
  installationId String
  profileId      String    @default("")
  skillSlug      String
  pinnedVersion  String?
  source         String    @default("magnus-skills") // magnus-skills | upload | agentskills.io
  enabled        Boolean   @default(true)
  lastSyncedAt   DateTime?
  status         String    @default("pending") // pending | applied | drifted | error
  error          String?
  metadata       String    @default("{}")
  createdBy      String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([installationId, profileId, skillSlug])
  @@index([installationId])
  @@index([profileId])
  @@index([status])
  @@map("hermes_skill_assignments")
}

/// Per-profile toolset policy — which Hermes toolsets are enabled and per-tool
/// approval/hook configuration.
model HermesToolsetPolicy {
  id             String    @id @default(cuid())
  installationId String
