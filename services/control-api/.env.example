# magnus-server configuration example.
#
# Copy to a private file (for example ~/.magnus/server.env, mode 0600) and
# pass it with `magnus-server --env-file <path>`, or use it as the Compose env
# file (docker/compose.yml). Variables already set in the environment win.
# An empty value means "unset". `magnus-server env-schema --format table`
# lists every documented variable; `magnus-server check` validates this file.
#
# Generate each secret with:  openssl rand -hex 32
# Every secret must be distinct; there are no fallback values.

# ═══════════════════════════════════════════════════════════════════════════
# Required
# ═══════════════════════════════════════════════════════════════════════════

NODE_ENV=production

# PostgreSQL. Required in production. (Development falls back to
# postgresql://magnus@127.0.0.1:5432/magnus with no password.)
DATABASE_URL=postgresql://magnus:change-me@127.0.0.1:5432/magnus
# Used only by docker/compose.yml to initialise its PostgreSQL container.
POSTGRES_PASSWORD=
# Redis (queues, rate limits, event bus).
REDIS_URL=redis://127.0.0.1:6379
# Used only by docker/compose.yml.
REDIS_PASSWORD=

# Purpose-specific secrets, 32+ characters each.
API_SECRET=
JWT_SECRET=
NODE_MANAGER_SECRET=
AUDIT_HMAC_SECRET=
RESULT_SIGNING_SECRET=
LOG_INGEST_SIGNING_SECRET=
CREDENTIAL_ROTATION_KEY=
METRICS_TOKEN=
WEBHOOK_ENCRYPTION_KEY=

# HTTPS listener. TLS is required in production. Relative paths resolve
# against the working directory; absolute paths are recommended.
TLS_CERT_PATH=/etc/magnus-server/tls/server.crt
TLS_KEY_PATH=/etc/magnus-server/tls/server.key
CONTROL_API_PORT=4000
# CONTROL_API_BIND_HOST=0.0.0.0
# Public URL of this server; agents use it to report back.
CONTROL_API_URL=https://magnus.example.com:4000
# Browser origins allowed to call the API (the Magnus dashboard).
CORS_ORIGIN=https://magnus.example.com:3000
# DASHBOARD_PUBLIC_ORIGIN=https://magnus.example.com:3000

# Local development only: serve cleartext HTTP on loopback without a certificate.
# ALLOW_INSECURE_HTTP=true

# ═══════════════════════════════════════════════════════════════════════════
# Paths (optional)
# ═══════════════════════════════════════════════════════════════════════════

# Base directory for audit logs, credential rotation state and backups.
# MAGNUS_HOME=~/.magnus
# AUDIT_LOG_DIR=$MAGNUS_HOME/audit-logs
# CREDENTIAL_ROTATION_STATE_PATH=$MAGNUS_HOME/state/credential-rotations.json
# SKILLS_DIR=                     # defaults to the bundled @hivemagnus/magnus-skills catalogue

# ═══════════════════════════════════════════════════════════════════════════
# Agents (optional)
# ═══════════════════════════════════════════════════════════════════════════

# Let agents self-register through the discovery endpoint.
# ENABLE_AGENT_DISCOVERY=true
# AGENT_DISCOVERY_SECRET=
# DNS suffix used to derive agent certificate hostnames, and an optional
# suffix under which agents report their FQDN (for example an overlay network).
# AGENT_TLS_DOMAIN_SUFFIX=example.com
# MAGNUS_NODE_DNS_SUFFIX=nodes.example.com
# SSH credentials for installing and upgrading agents over SSH.
# SSH_USERNAME=deploy
# SSH_PRIVATE_KEY_PATH=/etc/magnus-server/ssh/id_ed25519
# SSH_HOST_KEY_PINS_FILE=/etc/magnus-server/ssh/host-key-pins.json
# SSH_PASSWORD=
# Account whose docker group membership is checked on the server host.
# MAGNUS_DOCKER_USER=deploy
# Durable node and shared-resource lease coordination.
# MAGNUS_RESOURCE_LEASES_ENABLED=true

# ═══════════════════════════════════════════════════════════════════════════
# Optional integrations — each is off until configured
# ═══════════════════════════════════════════════════════════════════════════

# ── Interoperating with older clients (optional) ──
# JSON object mapping legacy /api/v1 path prefixes to current ones. Requests are
# rewritten before routing, so auth, scopes and audit see the current path.
# MAGNUS_ROUTE_ALIASES_JSON={"/api/v1/resource-leases/old-name/admission":"/api/v1/resource-leases/admission"}
# Legacy webhook type names mapped to a current format (generic, slack, discord, mattermost).
# MAGNUS_WEBHOOK_TYPE_ALIASES=legacy-chat=mattermost

# ── Hive IAM: verify RS256 access tokens issued by Hive IAM ──
# When set, JWT_SECRET is no longer required for user tokens.
# IAM_CORE_URL=https://iam.example.com
# IAM_TOKEN_ISSUER=https://iam.example.com
# IAM_TOKEN_AUDIENCE=magnus

# ── Hive Router (or any OpenAI-compatible router) for managed Hermes Agents ──
# HIVE_ROUTER_URL / HIVE_ROUTER_MODEL / HIVE_ROUTER_API_KEY are accepted as aliases.
# MAGNUS_ROUTER_URL=https://router.example.com/v1
# MAGNUS_ROUTER_MODEL=
# MAGNUS_ROUTER_API_KEY=
# HIVE_ROUTER_HEALTH_URL=https://router.example.com/health

# ── HiveMem shared agent memory ──
# HIVEMEM_URL=https://hivemem.example.com
# HIVEMEM_TOKEN=
# MAGNUS_LESSONS_HIVEMEM_URL=
# MAGNUS_LESSONS_HIVEMEM_TOKEN=

# ── Security Fusion / external security console ──
# off (default): disabled, /api/v1/security-fusion/* answers 404.
# local: cases, evidence and receipts live in this server's database.
# remote: observations are exported to an external security console.
# SECURITY_FUSION_MODE=off
# local mode:
# SECURITY_FUSION_RECEIPT_SIGNING_KEY=
# SECURITY_FUSION_EVIDENCE_DIR=$MAGNUS_HOME/security-fusion/evidence
# SECURITY_FUSION_CONTAINMENT_COMMAND=/usr/local/sbin/your-containment-helper
# SECURITY_FUSION_MATTERMOST_URL=https://chat.example.com
# SECURITY_FUSION_MATTERMOST_BOT_TOKEN=
# SECURITY_FUSION_MATTERMOST_CHANNEL_ID=
# remote mode:
# MAGNUS_SECURITY_CONSOLE_URL=https://security.example.com
# SECURITY_FUSION_API_URL=https://security.example.com
# SECURITY_EXPORT_ENABLED=true
# SECURITY_EXPORT_SECRET=
# SECURITY_SUMMARY_TOKEN=
# SECURITY_INVENTORY_TOKEN_SHA256=
# SECURITY_BACKUP_TOKEN_SHA256=
# SECURITY_BACKUP_DIRECTORY=$MAGNUS_HOME/security-backups

# ── Hermes Agent plugin API ──
# Plugin credentials are ignored and plugin routes are unreachable unless enabled.
# Store only SHA-256 digests of the tokens here.
# MAGNUS_PLUGIN_API_ENABLED=true
# MAGNUS_PLUGIN_READ_TOKEN_DIGESTS_JSON={"hermes-1":"<sha256 of the read token>"}
# MAGNUS_PLUGIN_OPERATOR_TOKEN_SHA256=
# Plugin read consumer allowed to relay signed team-approval decisions, plus the
# Ed25519 key and actor bindings those decisions are verified against.
# MAGNUS_APPROVAL_BRIDGE_CONSUMER=hermes-1
# APPROVAL_SIGNER_PUBLIC_KEY_PATH=/etc/magnus-server/approval-signer.pub
# APPROVAL_TELEGRAM_ACTOR_SHA256=
# APPROVAL_IPHONE_ACTOR_SHA256=
# Signature domain prefixes accepted for approval decisions; the first is preferred.
# Add a legacy signer domain (for example legacy.approval) to interoperate with older signers.
# MAGNUS_APPROVAL_ASSERTION_DOMAINS=magnus.approval-assertion
# Read-only digests for an external observability collector and the fleet-check reporter.
# MAGNUS_COLLECTOR_TOKEN_SHA256=
# MAGNUS_FLEET_CHECK_TOKEN_SHA256=

# ── Hermes registry (skills, plugins, MCP backends) ──
# Background import of the bundled skill catalogue and plugin source monitoring.
# MAGNUS_HERMES_REGISTRY_ENABLED=true
# Short hostnames (optionally host:stage; stage 0 = canary) that may pull deployments.
# MAGNUS_REGISTRY_DEPLOY_HOSTS=canary-1:0,node-1:1,node-2:2
# Hosts that may submit changes but never pull.
# MAGNUS_REGISTRY_SUBMIT_ONLY_HOSTS=

# ── Fleet AI assistant (all optional) ──
# OLLAMA_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=
# LLAMACPP_URL=http://127.0.0.1:8080
# OPENAI_API_KEY=
# OPENROUTER_API_KEY=
# ANTHROPIC_API_KEY=

# ═══════════════════════════════════════════════════════════════════════════
# Tuning (optional)
# ═══════════════════════════════════════════════════════════════════════════

# LOG_LEVEL=info
# DATABASE_POOL_SIZE=20
# LOG_RETENTION_DAYS=30
# HEALTH_SNAPSHOT_RETENTION_DAYS=7
# NOTIFICATION_READ_RETENTION_DAYS=30
# NOTIFICATION_MAX_RETENTION_DAYS=90
